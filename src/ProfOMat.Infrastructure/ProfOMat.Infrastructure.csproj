<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- nur für die einmalige Übernahme alter SQLite-Datenbanken (Datenbank/SqliteUebernahme.cs) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="ClosedXML" />
  </ItemGroup>

  <ItemGroup>
    <!-- Liberation-Schriften (SIL OFL 1.1) für PDFs, aus VibeVHS übernommen -->
    <EmbeddedResource Include="Schriften\*.ttf" LogicalName="ProfOMat.Schriften.%(Filename)%(Extension)" />
    <!-- Formularvorlagen der Hochschule (öffentlich), werden vom ProfOMat ausgefüllt -->
    <EmbeddedResource Include="Vorlagen\*.pdf" LogicalName="ProfOMat.Vorlagen.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProfOMat.Application\ProfOMat.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProfOMat.Application.Tests" />
  </ItemGroup>

</Project>
