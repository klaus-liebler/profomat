@page "/antraege/{Id:guid}"
@attribute [Authorize]
@using ProfOMat.Application.Konten
@inject Vorgang Vorgang
@inject Ortszeit Zeit
@inject NotificationService Hinweise

<PageTitle>@(ansicht?.Antrag.Nummer ?? "Antrag") · ProfOMat</PageTitle>

<a class="pm-zurueck" href="antraege">← Zur Antragsliste</a>

@if (ladefehler is not null)
{
    <section class="pm-card" role="alert"><h1>Antrag nicht verfügbar</h1><p>@ladefehler</p></section>
}
else if (ansicht is null || aktionen is null)
{
    <p class="pm-muted">Wird geladen …</p>
}
else
{
    var a = ansicht.Antrag;
    <div class="pm-head">
        <div>
            <h1>@ansicht.Pruefung.Anzeige</h1>
            <p>@a.Nummer · Mündliche Prüfung im dritten Versuch · @ansicht.Studiengang.Anzeige</p>
        </div>
        <StatusPille Stil="@Darstellung.Stil(a.Status)">@a.Status.Anzeigename()</StatusPille>
    </div>

    @if (fehler is not null)
    {
        <div class="pm-alert pm-crit" role="alert">@fehler</div>
    }
    @if (a.Rueckfrage is { } rueckfrage && a.Status == AntragStatus.BeimErstpruefer)
    {
        <div class="pm-alert pm-warn"><b>Rückfrage</b> – @rueckfrage</div>
    }
    @if (!ansicht.KetteInOrdnung)
    {
        <div class="pm-alert pm-crit" role="alert"><b>Achtung:</b> Mindestens eine Unterschrift ist nicht in Ordnung (siehe unten). Bitte die Systemverwaltung informieren.</div>
    }
    @if (a.Verfahren == Antragsverfahren.Antrag && a.Status.IstOffen())
    {
        <div class="pm-alert pm-warn">Dieser Antrag stammt aus dem früheren Verfahren (öffentliches Formular). Er lässt sich nicht mehr weiter unterschreiben,
            nur ablehnen; bitte bei Bedarf eine neue Einladung erstellen.</div>
    }

    @if (link is not null)
    {
        <EinladungslinkKarte Link="@link" Name="@a.Name" Pruefung="@ansicht.Pruefung.Anzeige" Absender="@ansicht.Erstpruefende.Anzeigename">
            <div class="pm-row"><button type="button" class="pm-btn" @onclick="() => link = null">Fertig</button></div>
        </EinladungslinkKarte>
    }

    <div class="pm-grid-2">
        <section class="pm-card">
            <h2>Studierende/r</h2>
            <dl class="pm-dl">
                <dt>Name</dt><dd>@a.Name</dd>
                <dt>Matrikelnummer</dt><dd>@(a.Matrikelnummer is { Length: > 0 } m ? m : "noch nicht angegeben")</dd>
                @if (a.Email is { Length: > 0 } mail)
                {
                    <dt>E-Mail</dt><dd><a href="mailto:@mail">@mail</a></dd>
                }
                <dt>Studiengang</dt><dd>@ansicht.Studiengang.Anzeige</dd>
                <dt>Prüfung</dt><dd>@ansicht.Pruefung.Anzeige @(ansicht.Pruefung.Pruefungsform is { } form ? $"(regulär: {form})" : "")</dd>
                <dt>Terminwünsche</dt><dd >@(a.Terminwuensche ?? "–")</dd>
                @if (a.Status == AntragStatus.Eingeladen && a.GueltigBis is { } bis)
                {
                    <dt>Link gültig bis</dt><dd>@Zeit.Kurz(bis)</dd>
                }
            </dl>
        </section>
        <section class="pm-card">
            <h2>Termin und Prüfende</h2>
            <dl class="pm-dl">
                <dt>Termin</dt><dd>@(ansicht.Termin ?? "noch offen")</dd>
                <dt>Ort</dt><dd>@(a.Ort ?? "noch offen")</dd>
                <dt>Erstprüfende/r</dt><dd>@ansicht.Erstpruefende.Anzeigename</dd>
                <dt>Zweitprüfende/r</dt><dd>@(a.ZweitpruefendeName ?? "noch offen")</dd>
                <dt>Bemerkung</dt><dd>@(a.Bemerkung ?? "–")</dd>
                @if (ansicht.Studiendekanat is { } dekan)
                {
                    <dt>Bestellt durch</dt><dd>@dekan.Anzeigename, @(a.Abgeschlossen is { } z ? Zeit.Kurz(z) : "")</dd>
                }
            </dl>
            <div class="pm-row">
                @if (aktionen.Pdf.Erlaubt)
                {
                    <a class="pm-btn" href="antraege/@Id/pdf" target="_blank" data-enhance-nav="false">Formular (PDF, aktueller Stand)</a>
                }
                else
                {
                    <BegruendeterButton Text="Formular (PDF)" Freigabe="@aktionen.Pdf" />
                }
            </div>
        </section>
    </div>

    @* ---------------- Einladung: Studierende sind dran ---------------- *@
    @if (a.Status == AntragStatus.Eingeladen || aktionen.LinkErneuern.Erlaubt)
    {
        <section class="pm-card">
            <h2>Einladungslink</h2>
            <p class="pm-small pm-muted">Die bzw. der Studierende ergänzt über den Link Matrikelnummer und Terminwünsche und unterschreibt. Der Link wird aus Sicherheitsgründen
                nur beim Erzeugen angezeigt; ist er verloren oder abgelaufen, erzeugen Sie einen neuen (der alte gilt dann nicht mehr).</p>
            <div class="pm-row">
                <label class="pm-lbl" for="tage">Gültig (Tage)</label>
                <input id="tage" class="pm-input" type="number" min="1" max="@Einladungsangaben.MaxGueltigTage" @bind="gueltigTage" style="max-width:100px" />
                <BegruendeterButton Text="Neuen Link erzeugen" Freigabe="@aktionen.LinkErneuern" Beschaeftigt="@beschaeftigt" Click="LinkErneuernAsync" />
                <BegruendeterButton Text="Einladung zurücknehmen" Gefahr="true" Freigabe="@aktionen.EinladungZuruecknehmen" Beschaeftigt="@beschaeftigt"
                                    Click="EinladungZuruecknehmenAsync" />
            </div>
        </section>
    }

    @* ---------------- Erstprüfende: Termin, Ort, Zweitprüfende ---------------- *@
    @if (aktionen.Festlegen.Erlaubt && vorlage is null)
    {
        <section class="pm-card">
            <h2>Termin, Ort und Zweitprüfende</h2>
            <p class="pm-small pm-muted">Nach Rücksprache mit der/dem Zweitprüfenden. Die letzte Wiederholung findet in Präsenz statt (ATPO § 6 Abs. 1a Satz 2).
                Speichern merkt die Angaben vor; verbindlich werden sie mit Ihrer Unterschrift. Danach unterschreibt die/der Zweitprüfende.</p>
            <div class="pm-fields">
                <div class="pm-field">
                    <label class="pm-lbl">Datum und Uhrzeit</label>
                    <RadzenDatePicker TValue="DateTime?" @bind-Value="termin" ShowTime="true" HourFormat="24" DateFormat="dd.MM.yyyy HH:mm" Min="@DateTime.Today"
                                      AllowClear="true" Style="width:100%" />
                </div>
                <div class="pm-field">
                    <label class="pm-lbl" for="ort">Ort (Raum)</label>
                    <input id="ort" class="pm-input" @bind="ort" maxlength="200" placeholder="z. B. SI 0012, Campus Westerberg" />
                </div>
                <div class="pm-field">
                    <label class="pm-lbl">Zweitprüfende/r</label>
                    <RadzenDropDown TValue="Guid?" Data="@zweitAuswahl" TextProperty="@nameof(Konto.Sortiername)" ValueProperty="@nameof(Konto.Id)" @bind-Value="zweitId"
                                    AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowClear="true"
                                    Placeholder="aus der Liste wählen …" Style="width:100%" />
                    <span class="pm-hilfe">Unterschreibt ebenfalls im ProfOMat und braucht dafür ein Konto.</span>
                </div>
                <div class="pm-field pm-field-weit">
                    <label class="pm-lbl" for="bemerkung">Bemerkung (optional, erscheint auf dem Beiblatt)</label>
                    <textarea id="bemerkung" class="pm-textarea" @bind="bemerkung" maxlength="2000"></textarea>
                </div>
            </div>
            <div class="pm-row">
                <BegruendeterButton Text="Speichern" Click="FestlegungSpeichernAsync" Beschaeftigt="@beschaeftigt" />
                <BegruendeterButton Text="Speichern und unterschreiben" Haupt="true" Beschaeftigt="@beschaeftigt"
                                    Freigabe="@(a.Status == AntragStatus.BeimErstpruefer ? Freigabe.Ja : Freigabe.Nein("Erst unterschreibt die/der Studierende über den Link."))"
                                    Click="ErstpruefungVorbereitenAsync" />
            </div>
        </section>
    }

    @* ---------------- Zweitprüfende ---------------- *@
    @if (a.Status == AntragStatus.BeimZweitpruefer && vorlage is null)
    {
        <section class="pm-card">
            <h2>Zweitprüfung</h2>
            <p class="pm-small pm-muted">@ansicht.Erstpruefende.Anzeigename hat Termin und Ort festgelegt und unterschrieben. Mit Ihrer Unterschrift übernehmen Sie die
                Prüfung als Zweitprüfende/r. Passt etwas nicht, geben Sie den Antrag mit Rückfrage zurück.</p>
            <div class="pm-row">
                <BegruendeterButton Text="Unterschreiben" Haupt="true" Freigabe="@aktionen.ZweitpruefungUnterschreiben"
                                    Click="@(() => VorlageLadenAsync(Signaturschritt.Zweitpruefung))" />
            </div>
        </section>
    }

    @* ---------------- Studiendekanat außerhalb ---------------- *@
    @if (a.Status == AntragStatus.ExternWeiterleiten)
    {
        <section class="pm-card pm-hervor">
            <h2>Weiter an das Studiendekanat (außerhalb des ProfOMat)</h2>
            <p>Für diesen Studiengang ist kein Studiendekanat im ProfOMat hinterlegt. Bitte laden Sie das von Studierender/Studierendem, Erst- und
                Zweitprüfenden unterschriebene Formular herunter und leiten Sie es an die Studiendekanin bzw. den Studiendekan weiter; von dort geht es an das
                Studierendensekretariat (@ansicht.SekretariatEmail).</p>
            <div class="pm-row">
                <a class="pm-btn pm-btn-haupt" href="antraege/@Id/pdf" target="_blank" data-enhance-nav="false">Formular (PDF) herunterladen</a>
                <BegruendeterButton Text="Als weitergeleitet melden" Freigabe="@aktionen.WeitergeleitetMelden" Beschaeftigt="@beschaeftigt" Click="WeitergeleitetAsync" />
            </div>
        </section>
    }

    @* ---------------- Studiendekanat im ProfOMat ---------------- *@
    @if (a.Status == AntragStatus.BeimStudiendekanat && vorlage is null)
    {
        <section class="pm-card">
            <h2>Bestellung der Prüfenden (Studiendekanat)</h2>
            <p class="pm-small pm-muted">Mit Ihrer Unterschrift bestellen Sie die Prüfenden (ATPO § 24 Abs. 2). Danach laden Sie das vollständige Formular herunter
                und schicken es an das Studierendensekretariat.</p>
            <div class="pm-row">
                <BegruendeterButton Text="Prüfende bestellen und unterschreiben" Haupt="true" Freigabe="@aktionen.Genehmigen"
                                    Click="@(() => VorlageLadenAsync(Signaturschritt.Studiendekanat))" />
            </div>
        </section>
    }

    @if (a.Status == AntragStatus.Abgeschlossen)
    {
        <section class="pm-card">
            <h2>An das Studierendensekretariat</h2>
            <p>Alle haben unterschrieben. Bitte das vollständige Formular herunterladen und an das Studierendensekretariat schicken.</p>
            <div class="pm-row">
                <a class="pm-btn pm-btn-haupt" href="antraege/@Id/pdf" target="_blank" data-enhance-nav="false">Formular (PDF) herunterladen</a>
                <a class="pm-btn" href="@SekretariatMail(ansicht)" data-enhance-nav="false">Mail an @ansicht.SekretariatEmail vorbereiten</a>
            </div>
            <p class="pm-small pm-muted">Das PDF bitte selbst an die Mail anhängen.</p>
        </section>
    }

    @if (aktionen.Zurueckgeben.Erlaubt && vorlage is null)
    {
        <details class="pm-card">
            <summary><b>Mit Rückfrage an die/den Erstprüfende/n zurückgeben</b></summary>
            <p class="pm-small pm-muted">Die Unterschriften der Prüfenden gelten dann nicht mehr (sie bleiben als „überholt“ sichtbar); die Unterschrift der/des
                Studierenden bleibt.</p>
            <textarea class="pm-textarea" @bind="rueckfrageText" maxlength="2000" aria-label="Rückfrage"></textarea>
            <div><BegruendeterButton Text="Zurückgeben" Click="ZurueckgebenAsync" Beschaeftigt="@beschaeftigt"
                                     Freigabe="@(string.IsNullOrWhiteSpace(rueckfrageText) ? Freigabe.Nein("Bitte zuerst die Rückfrage eintragen.") : Freigabe.Ja)" /></div>
        </details>
    }

    @if (vorlage is not null)
    {
        <Unterschreiben @ref="unterschreiben" Text="@vorlage.Text" Titel="@Titel(vorlage.Schritt)" Unterzeichner="@vorlage.Unterzeichner" Beschaeftigte="true"
                        Beschaeftigt="@beschaeftigt" Knopftext="@(vorlage.Schritt == Signaturschritt.Studiendekanat ? "Unterschreiben und abschließen" : "Unterschreiben und weitergeben")"
                        Unterschrieben="UnterschriebenAsync">
            <button type="button" class="pm-btn" @onclick="() => vorlage = null">Abbrechen</button>
        </Unterschreiben>
    }

    @* ---------------- Ablehnen ---------------- *@
    @if (aktionen.Ablehnen.Erlaubt && vorlage is null)
    {
        <details class="pm-card">
            <summary><b>Antrag ablehnen</b></summary>
            <p class="pm-small pm-muted">Die/der Studierende sieht die Begründung über ihren bzw. seinen Link. Bitte zusätzlich persönlich informieren.</p>
            <textarea class="pm-textarea" @bind="ablehnungsgrund" maxlength="2000" aria-label="Begründung der Ablehnung"></textarea>
            <div><BegruendeterButton Text="Ablehnen" Gefahr="true" Click="AblehnenAsync"
                                     Freigabe="@(string.IsNullOrWhiteSpace(ablehnungsgrund) ? Freigabe.Nein("Bitte zuerst begründen.") : Freigabe.Ja)" /></div>
        </details>
    }

    @if (schritte.Count > 0)
    {
        <NaechsteSchritte Schritte="@schritte" />
    }

    <section class="pm-card">
        <h2>Unterschriften</h2>
        @if (ansicht.Signaturen.Count == 0)
        {
            <p class="pm-muted">Noch keine. Als Erstes unterschreibt die/der Studierende über den Einladungslink.</p>
        }
        @foreach (var b in ansicht.Signaturen)
        {
            var s = b.Signatur;
            <div class="pm-sig @(s.Ueberholt is null ? "" : "ueberholt")">
                <div>
                    @if (s.Art == Signaturart.Handschrift && s.BildPng is { } png)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(png)" alt="Unterschrift @s.Unterzeichner" />
                    }
                    else
                    {
                        <div class="pm-sig-schluessel">Digital signiert<br />@s.Algorithmus<br /><span class="pm-mono">@SignaturPruefung.OeffentlicherSchluessel.Kurz(s.Fingerabdruck ?? new string('0', 16))</span></div>
                    }
                </div>
                <div>
                    <b>@s.Schritt.Anzeigename()</b> · @s.Unterzeichner · @Zeit.Kurz(s.Zeitpunkt)
                    @if (s.Ueberholt is not null) { <StatusPille Stil="neutral">überholt</StatusPille> }
                    else if (b.Gueltig) { <StatusPille Stil="gut">geprüft</StatusPille> }
                    else { <StatusPille Stil="krit">fehlerhaft</StatusPille> }
                    <ul class="pm-zeilen pm-small pm-muted">
                        @foreach (var h in b.Hinweise) { <li>@h</li> }
                    </ul>
                    <details class="pm-small"><summary>Unterschriebener Text (SHA-256 <span class="pm-mono">@s.InhaltHash[..16]…</span>)</summary><pre class="pm-signiertext">@s.Inhalt</pre></details>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AntragAnsicht? ansicht;
    private AntragAktionen? aktionen;
    private string? ladefehler;
    private string? fehler;
    private bool beschaeftigt;
    private Signiervorlage? vorlage;
    private Unterschreiben? unterschreiben;
    private Einladungslink? link;
    private IReadOnlyList<Konto> zweitAuswahl = [];
    private IReadOnlyList<NaechsterSchritt> schritte = [];

    private DateTime? termin;
    private string? ort, bemerkung;
    private Guid? zweitId;
    private string? rueckfrageText, ablehnungsgrund;
    private int gueltigTage = 14;

    protected override async Task OnParametersSetAsync()
    {
        await LadenAsync();
        if (ansicht is { } v)
        {
            FormularUebernehmen(v.Antrag);
            (zweitAuswahl, gueltigTage) = await Vorgang.AusfuehrenAsync(async d => (
                (IReadOnlyList<Konto>)(await d.GetRequiredService<KontoDienst>().PruefendeAsync()).Where(k => k.Id != v.Antrag.ErstpruefendeKontoId).ToList(),
                d.GetRequiredService<DrittpruefungDienst>().EinladungGueltigTage));
        }
    }

    private void FormularUebernehmen(Antrag a)
    {
        termin = a.Termin is { } t ? Zeit.Lokal(t) : null;
        ort = a.Ort;
        zweitId = a.ZweitpruefendeKontoId;
        bemerkung = a.Bemerkung;
    }

    private async Task LadenAsync()
    {
        try
        {
            (ansicht, aktionen) = await Vorgang.AusfuehrenAsync(async d =>
            {
                var dienst = d.GetRequiredService<DrittpruefungDienst>();
                return (await dienst.AnsichtAsync(Id), await dienst.AktionenAsync(Id));
            });
        }
        catch (FachlicherFehler ex)
        {
            ladefehler = ex.Message;
        }
    }

    private static string Titel(Signaturschritt schritt) => schritt switch
    {
        Signaturschritt.Erstpruefung => "Als Erstprüfende/r unterschreiben",
        Signaturschritt.Zweitpruefung => "Als Zweitprüfende/r unterschreiben",
        _ => "Bestellung unterschreiben",
    };

    private static string SekretariatMail(AntragAnsicht a)
    {
        var betreff = $"Antrag auf mündliche Wiederholungsprüfung (3. Versuch) {a.Antrag.Matrikelnummer} – {a.Pruefung.Titel} ({a.Antrag.Nummer})";
        var text = $"Guten Tag,\r\n\r\nanbei der vollständig unterschriebene Antrag auf mündliche Wiederholungsprüfung im dritten Versuch:\r\n\r\n"
                   + $"Prüfling: {a.Antrag.Name}, Matrikelnummer {a.Antrag.Matrikelnummer}\r\nStudiengang: {a.Studiengang.Anzeige}\r\nPrüfung: {a.Pruefung.Anzeige}\r\n"
                   + $"Termin: {a.Termin}\r\nOrt: {a.Antrag.Ort}\r\nPrüfende: {a.Erstpruefende.Anzeigename} und {a.Antrag.ZweitpruefendeName}\r\n\r\n"
                   + $"Prüfwert (SHA-256): {a.Pruefwert}\r\n\r\nViele Grüße";
        return $"mailto:{a.SekretariatEmail}?subject={Uri.EscapeDataString(betreff)}&body={Uri.EscapeDataString(text)}";
    }

    private async Task AusfuehrenAsync(Func<IServiceProvider, Task> arbeit, string erfolg, Func<IReadOnlyList<NaechsterSchritt>>? danach = null)
    {
        fehler = null;
        beschaeftigt = true;
        try
        {
            await Vorgang.AusfuehrenAsync(arbeit);
            await LadenAsync();
            Hinweise.Notify(NotificationSeverity.Success, erfolg);
            schritte = danach?.Invoke() ?? [];
        }
        catch (FachlicherFehler ex)
        {
            fehler = ex.Message;
            unterschreiben?.FehlerZeigen(ex.Message);
        }
        finally
        {
            beschaeftigt = false;
        }
    }

    private Festlegung AktuelleEingabe() => new(termin is { } t ? Zeit.AlsUtc(t) : null, ort, zweitId, null, null, bemerkung);

    private Task FestlegungSpeichernAsync()
    {
        var f = AktuelleEingabe();
        return AusfuehrenAsync(d => d.GetRequiredService<DrittpruefungDienst>().FestlegungSpeichernAsync(Id, f), "Gespeichert.");
    }

    private async Task ErstpruefungVorbereitenAsync()
    {
        fehler = null;
        try
        {
            var f = AktuelleEingabe();
            vorlage = await Vorgang.AusfuehrenAsync(async d =>
            {
                var dienst = d.GetRequiredService<DrittpruefungDienst>();
                await dienst.FestlegungSpeichernAsync(Id, f);
                return await dienst.VorlageAsync(Id, Signaturschritt.Erstpruefung);
            });
        }
        catch (FachlicherFehler ex)
        {
            fehler = ex.Message;
            await LadenAsync();
        }
    }

    private async Task VorlageLadenAsync(Signaturschritt schritt)
    {
        fehler = null;
        try
        {
            vorlage = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DrittpruefungDienst>().VorlageAsync(Id, schritt));
        }
        catch (FachlicherFehler ex)
        {
            fehler = ex.Message;
        }
    }

    private async Task UnterschriebenAsync(Unterschrift u)
    {
        var v = vorlage!;
        await AusfuehrenAsync(d => v.Schritt switch
            {
                Signaturschritt.Erstpruefung => d.GetRequiredService<DrittpruefungDienst>().ErstpruefungUnterschreibenAsync(Id, v.Zeitpunkt, v.Text, u),
                Signaturschritt.Zweitpruefung => d.GetRequiredService<DrittpruefungDienst>().ZweitpruefungUnterschreibenAsync(Id, v.Zeitpunkt, v.Text, u),
                _ => d.GetRequiredService<DrittpruefungDienst>().GenehmigenAsync(Id, v.Zeitpunkt, v.Text, u),
            },
            v.Schritt switch
            {
                Signaturschritt.Erstpruefung => "Unterschrieben; die/der Zweitprüfende ist informiert.",
                Signaturschritt.Zweitpruefung => "Unterschrieben.",
                _ => "Bestellt. Bitte das Formular an das Studierendensekretariat schicken.",
            },
            () => NachDerUnterschrift(v.Schritt));
        if (fehler is null)
        {
            vorlage = null;
        }
    }

    private IReadOnlyList<NaechsterSchritt> NachDerUnterschrift(Signaturschritt schritt) => schritt switch
    {
        Signaturschritt.Zweitpruefung when ansicht?.Antrag.Status == AntragStatus.ExternWeiterleiten =>
        [
            new NaechsterSchritt("Formular (PDF) herunterladen", $"antraege/{Id}/pdf", "und an die Studiendekanin bzw. den Studiendekan weiterleiten.", Hauptschritt: true),
            new NaechsterSchritt("Zurück zu meinen Aufgaben", ""),
        ],
        Signaturschritt.Studiendekanat =>
        [
            new NaechsterSchritt("Formular (PDF) herunterladen", $"antraege/{Id}/pdf", "und an das Studierendensekretariat schicken.", Hauptschritt: true),
            new NaechsterSchritt("Zurück zu meinen Aufgaben", ""),
        ],
        _ => [new NaechsterSchritt("Zurück zu meinen Aufgaben", "", Hauptschritt: true), new NaechsterSchritt("Alle Anträge", "antraege")],
    };

    private async Task LinkErneuernAsync()
    {
        fehler = null;
