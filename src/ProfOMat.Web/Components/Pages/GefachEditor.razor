    private static string Mm(decimal d) => d.ToString("0.##", Deutsch);

    private static string Mm(double d) => d.ToString("0.#", Deutsch);

    private static decimal? Zahl(string? s) => decimal.TryParse(s?.Trim().Replace(',', '.'), NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign,
        CultureInfo.InvariantCulture, out var d) ? d : null;
}
