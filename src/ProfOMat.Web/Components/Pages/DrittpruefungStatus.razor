@page "/drittpruefung/status/{Id:guid}/{Token}"
@attribute [AllowAnonymous]
@inject Vorgang Vorgang
@inject Ortszeit Zeit

<PageTitle>Ihr Antrag · ProfOMat</PageTitle>

@if (ansicht is null)
{
    <section class="pm-card">
        <h1>Antrag nicht gefunden</h1>
        <p>Der Link ist unvollständig oder ungültig. Bitte den Link aus der Mail vollständig öffnen.</p>
    </section>
}
else
{
    var a = ansicht.Antrag;
    <div class="pm-head">
        <div>
            <h1>Ihr Antrag @a.Nummer</h1>
            <p>Mündliche Prüfung im dritten Versuch: @ansicht.Pruefung.Anzeige (@ansicht.Studiengang.Anzeige)</p>
        </div>
        <StatusPille Stil="@Darstellung.Stil(a.Status)">@a.Status.Anzeigename()</StatusPille>
    </div>

    @if (meldung is not null)
    {
        <div class="pm-alert pm-gut" role="status">@meldung</div>
    }
    @if (fehler is not null)
    {
        <div class="pm-alert pm-crit" role="alert">@fehler</div>
    }

    @if (a.Status == AntragStatus.WartetAufBestaetigung)
    {
        <section class="pm-card">
            <h2>Bitte bestätigen</h2>
            <p>Mit der Bestätigung geht Ihr unterschriebener Antrag an <b>@ansicht.Erstpruefende.Anzeigename</b>.</p>
            <div><BegruendeterButton Text="Antrag bestätigen und absenden" Haupt="true" Click="BestaetigenAsync" /></div>
        </section>
    }

    <div class="pm-grid-2">
        <section class="pm-card">
            <h2>Stand</h2>
            <dl class="pm-dl">
                <dt>Name</dt><dd>@a.Name (@a.Matrikelnummer)</dd>
                <dt>Erstprüfende/r</dt><dd>@ansicht.Erstpruefende.Anzeigename</dd>
                <dt>Zweitprüfende/r</dt><dd>@(a.ZweitpruefendeName ?? "noch offen")</dd>
                <dt>Termin</dt><dd>@(ansicht.Termin is { } t ? (a.Status == AntragStatus.Abgeschlossen ? t : t + " (vorläufig)") : "noch offen")</dd>
                <dt>Ort</dt><dd>@(a.Ort ?? "noch offen")</dd>
                <dt>Eingereicht</dt><dd>@Zeit.Kurz(a.Erstellt)</dd>
                @if (a.Ablehnungsgrund is { } grund)
                {
                    <dt>Abgelehnt von</dt><dd>@a.AbgelehntVon</dd>
                    <dt>Begründung</dt><dd>@grund</dd>
                }
            </dl>
        </section>
        <section class="pm-card">
            <h2>Unterschriften</h2>
            <ul class="pm-zeilen">
                @foreach (var s in ansicht.Signaturen.Where(s => s.Signatur.Ueberholt is null))
                {
                    <li>@s.Signatur.Schritt.Anzeigename(): @s.Signatur.Unterzeichner, @Zeit.Kurz(s.Signatur.Zeitpunkt)
                        @if (s.Gueltig) { <StatusPille Stil="gut">geprüft</StatusPille> } else { <StatusPille Stil="krit">fehlerhaft</StatusPille> }</li>
                }
            </ul>
            @if (a.Status == AntragStatus.Abgeschlossen)
            {
                <div><a class="pm-btn pm-btn-haupt" href="drittpruefung/status/@Id/@Token/pdf" target="_blank" data-enhance-nav="false">Dokument (PDF) öffnen</a></div>
            }
        </section>
    </div>

    @if (a.Status.IstOffen())
    {
        <section class="pm-card">
            <h2>Antrag zurückziehen</h2>
            <p class="pm-muted">Solange die Prüfung nicht bestellt ist, können Sie den Antrag zurückziehen. Die Prüfenden werden informiert.</p>
            <label class="pm-check"><input type="checkbox" @bind="zurueckziehenBestaetigt" /> Ja, ich ziehe den Antrag zurück.</label>
            <div><BegruendeterButton Text="Zurückziehen" Gefahr="true" Click="ZurueckziehenAsync"
                                     Freigabe="@(zurueckziehenBestaetigt ? Freigabe.Ja : Freigabe.Nein("Bitte zuerst das Kästchen ankreuzen."))" /></div>
        </section>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string Token { get; set; } = string.Empty;

    private AntragAnsicht? ansicht;
    private string? meldung;
    private string? fehler;
    private bool zurueckziehenBestaetigt;

    protected override async Task OnParametersSetAsync()
        => ansicht = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DrittpruefungDienst>().StudierendenAnsichtAsync(Id, Token));

    private async Task BestaetigenAsync()
    {
        ansicht = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DrittpruefungDienst>().BestaetigenAsync(Id, Token));
        meldung = "Danke! Ihr Antrag ist an die Erstprüferin bzw. den Erstprüfer gegangen. Sie bekommen eine Mail, sobald der Termin feststeht.";
    }

    private async Task ZurueckziehenAsync()
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DrittpruefungDienst>().ZurueckziehenAsync(Id, Token));
            ansicht = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DrittpruefungDienst>().StudierendenAnsichtAsync(Id, Token));
            meldung = "Der Antrag ist zurückgezogen.";
        }
        catch (FachlicherFehler ex)
        {
            fehler = ex.Message;
        }
    }
}
