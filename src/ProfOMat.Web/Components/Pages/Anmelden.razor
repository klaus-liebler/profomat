@page "/anmelden"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout LeeresLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using ProfOMat.Application.Konten
@inject KontoDienst Konten
@inject NavigationManager Navigation
@inject IConfiguration Konfiguration
@inject Anmeldebremse Bremse
@inject ILogger<Anmelden> Log

<PageTitle>@(ersteinrichtung ? "Ersteinrichtung" : "Anmelden") · ProfOMat</PageTitle>

<div class="pm-login">
    <div class="pm-row"><span class="pm-brand-zeichen">P</span><h1>@(ersteinrichtung ? "Ersteinrichtung" : "Anmelden")</h1></div>
    <p class="pm-muted">Für Lehrende, Studiendekanat und Verwaltung. Studierende brauchen für den Antrag auf mündliche Drittprüfung keine Anmeldung:
        <a href="drittpruefung/antrag">direkt zum Antrag</a>.</p>

    @if (fehler is not null)
    {
        <div class="pm-alert pm-crit" role="alert">@fehler</div>
    }

    @if (ersteinrichtung)
    {
        <div class="pm-alert pm-warn">
            Es gibt noch kein Konto. Legen Sie jetzt das erste Konto der <b>Systemverwaltung</b> an – danach ist die Ersteinrichtung gesperrt;
            weitere Kolleginnen und Kollegen laden Sie unter <i>Verwaltung → Konten</i> per Einladungslink ein.
        </div>
        <form method="post" @formname="einrichtung" @onsubmit="EinrichtenAsync" class="pm-fields">
            <AntiforgeryToken />
            <div class="pm-field"><label class="pm-lbl" for="e-kennung">Kennung</label>
                <input id="e-kennung" name="EKennung" class="pm-input" autocomplete="username" required value="@EKennung" placeholder="z. B. liebler" /></div>
            <div class="pm-field"><label class="pm-lbl" for="e-titel">Titel</label>
                <input id="e-titel" name="ETitel" class="pm-input" value="@ETitel" placeholder="Prof. Dr." /></div>
            <div class="pm-field"><label class="pm-lbl" for="e-vorname">Vorname</label>
                <input id="e-vorname" name="EVorname" class="pm-input" autocomplete="given-name" value="@EVorname" /></div>
            <div class="pm-field"><label class="pm-lbl" for="e-nachname">Nachname</label>
                <input id="e-nachname" name="ENachname" class="pm-input" autocomplete="family-name" required value="@ENachname" /></div>
            <div class="pm-field pm-field-weit"><label class="pm-lbl" for="e-mail">Mail</label>
                <input id="e-mail" name="EMail" type="email" class="pm-input" autocomplete="email" required value="@EMail" /></div>
            <div class="pm-field"><label class="pm-lbl" for="e-pw">Passwort (mind. @KontoDienst.MinPasswortLaenge Zeichen)</label>
                <input id="e-pw" name="EPasswort" type="password" class="pm-input" autocomplete="new-password" required minlength="@KontoDienst.MinPasswortLaenge" /></div>
            <div class="pm-field"><label class="pm-lbl" for="e-pw2">Passwort wiederholen</label>
                <input id="e-pw2" name="EPasswort2" type="password" class="pm-input" autocomplete="new-password" required /></div>
            <div class="pm-field pm-field-weit">
                <label class="pm-check"><input type="checkbox" name="EPruefende" value="true" checked /> Ich prüfe auch selbst (Rolle Prüfende)</label>
            </div>
            <div class="pm-field pm-field-weit"><div><button type="submit" class="pm-btn pm-btn-haupt">Konto anlegen und anmelden</button></div></div>
        </form>
    }
    else
    {
        <form method="post" @formname="passwort" @onsubmit="PasswortAsync" class="pm-fields">
            <AntiforgeryToken />
            <div class="pm-field">
                <label class="pm-lbl" for="kennung">Kennung</label>
                <input id="kennung" name="Kennung" class="pm-input" autocomplete="username" required value="@Kennung" />
            </div>
            <div class="pm-field">
                <label class="pm-lbl" for="pw">Passwort</label>
                <input id="pw" name="Passwort" type="password" class="pm-input" autocomplete="current-password" required />
            </div>
            <div class="pm-field pm-field-weit"><div><button type="submit" class="pm-btn pm-btn-haupt">Anmelden</button></div></div>
        </form>
        <p class="pm-small pm-muted">Neu hier oder Passwort vergessen? Die Systemverwaltung schickt Ihnen einen Einladungs- bzw. Passwort-Link.</p>

        <div class="pm-alert pm-info pm-small">
            <b>Hochschulkennung (Single Sign-on)</b> folgt: Anmeldung über den Shibboleth-IdP der Hochschule (DFN-AAI), sobald der Dienst beim
            Rechenzentrum registriert ist. Bis dahin gibt es lokale Konten.
        </div>
    }

    @if (testanmeldung && !ersteinrichtung)
    {
        <h2>Testanmeldung (nur Entwicklung)</h2>
        <form method="post" @formname="test" @onsubmit="TestAsync">
            <AntiforgeryToken />
            <div class="pm-list">
                @foreach (var k in konten)
                {
                    <div>
                        <span class="pm-grow"><b>@k.Anzeigename</b><br /><span class="pm-small pm-muted">@string.Join(", ", k.Rollen.Select(r => r.Rolle.Anzeigename()))</span></span>
                        <button type="submit" name="Test" value="@k.Id" class="pm-btn">Anmelden</button>
                    </div>
                }
            </div>
        </form>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "passwort")]
    private string? Kennung { get; set; }

    [SupplyParameterFromForm(FormName = "passwort")]
    private string? Passwort { get; set; }

    [SupplyParameterFromForm(FormName = "test")]
    private Guid? Test { get; set; }

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private string? EKennung { get; set; }

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private string? ETitel { get; set; }

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private string? EVorname { get; set; }

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private string? ENachname { get; set; }

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private string? EMail { get; set; }

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private string? EPasswort { get; set; }

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private string? EPasswort2 { get; set; }

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private bool EPruefende { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? fehler;
    private bool testanmeldung, ersteinrichtung;
    private IReadOnlyList<Konto> konten = [];

    private string? Ip => HttpContext.Connection.RemoteIpAddress?.ToString();

    protected override async Task OnInitializedAsync()
    {
        ersteinrichtung = await Konten.ErsteinrichtungNoetigAsync();
        testanmeldung = Konfiguration.GetValue("Anmeldung:TestanmeldungErlaubt", false);
        if (testanmeldung)
        {
            konten = (await Konten.AlleAsync()).Where(k => k.Aktiv).OrderBy(k => k.Rollen.Min(r => r.Rolle)).ThenBy(k => k.Nachname).ToList();
        }
    }

    private async Task PasswortAsync()
    {
        var kennung = Kennung ?? "";
        if (Bremse.Wartezeit(Ip, kennung) is { } warten)
        {
            fehler = $"Zu viele Fehlversuche. Bitte in {Math.Ceiling(warten.TotalSeconds):0} s erneut versuchen.";
            return;
        }

        var benutzer = await Konten.PasswortAnmeldenAsync(kennung, Passwort ?? "");
        if (benutzer is null)
        {
            Bremse.Fehlversuch(Ip, kennung);
            Log.LogWarning("Anmeldung fehlgeschlagen");
            fehler = "Kennung oder Passwort stimmen nicht.";
            return;
        }

        Bremse.Erfolg(Ip, kennung);
        await AnmeldenAsync(benutzer, "Passwort");
    }

    private async Task EinrichtenAsync()
    {
        if (EPasswort != EPasswort2)
        {
            fehler = "Die beiden Passwörter stimmen nicht überein.";
            return;
        }

        try
        {
            var benutzer = await Konten.ErsteinrichtenAsync(new Kontoangaben(EKennung ?? "", ETitel, EVorname ?? "", ENachname ?? "", EMail ?? ""),
                EPasswort ?? "", EPruefende);
            Log.LogInformation("Ersteinrichtung: Konto {Konto} angelegt", Pseudonym.Id(benutzer.KontoIdPflicht));
            await AnmeldenAsync(benutzer, "Passwort");
        }
        catch (FachlicherFehler ex)
        {
            fehler = ex.Message;
            ersteinrichtung = await Konten.ErsteinrichtungNoetigAsync();
        }
    }

    private async Task TestAsync()
    {
        if (!testanmeldung || Test is not { } id || await Konten.TestanmeldungAsync(id) is not { } benutzer)
        {
            fehler = "Testanmeldung nicht möglich.";
            return;
        }

        await AnmeldenAsync(benutzer, "Test");
    }

    private async Task AnmeldenAsync(Benutzer benutzer, string art)
    {
        var stempel = await Konten.StempelAsync(benutzer.KontoIdPflicht) ?? throw new FachlicherFehler("Das Konto ist gesperrt.");
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme,
            Anmeldung.Principal(benutzer, art, CookieAuthenticationDefaults.AuthenticationScheme, stempel));
        Log.LogInformation("Anmeldung ({Art}) Konto {Konto}", art, Pseudonym.Id(benutzer.KontoIdPflicht));
        Navigation.NavigateTo(Ruecksprung.Lokal(ReturnUrl, new Uri(Navigation.BaseUri).AbsolutePath));
    }
}
