@*
    „Nächste sinnvolle Schritte“: nach jeder Aktion die naheliegenden Folgeschritte anbieten (wie VibeVHS).
*@
@if (Schritte.Count > 0)
{
    <section class="pm-next" aria-label="@Titel">
        <h3>@Titel</h3>
        <div class="pm-row">
            @foreach (var s in Schritte)
            {
                @if (s.Freigabe is { Erlaubt: false } nein)
                {
                    <span class="pm-why" tabindex="0" data-why="@nein.Begruendung"><span class="pm-btn" aria-disabled="true">@s.Titel</span></span>
                }
                else
                {
                    <a class="@(s.Hauptschritt ? "pm-btn pm-btn-haupt" : "pm-btn")" href="@s.Ziel" title="@s.Hinweis" data-enhance-nav="@(IstDatei(s.Ziel) ? "false" : null)" target="@(IstDatei(s.Ziel) ? "_blank" : null)">@s.Titel</a>
                }
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public string Titel { get; set; } = "Nächste sinnvolle Schritte";

    [Parameter, EditorRequired]
    public IReadOnlyList<NaechsterSchritt> Schritte { get; set; } = [];

    /// <summary>Downloads (PDF, CSV, XLSX, EML, ZIP, ICS) brauchen einen echten Seitenaufruf statt der Blazor-Navigation.</summary>
    private static bool IstDatei(string ziel)
    {
        var pfad = ziel.Split('?')[0];
        return new[] { "pdf", ".csv", ".xlsx", ".eml", ".zip", ".ics" }.Any(e => pfad.EndsWith(e, StringComparison.Ordinal));
    }
}
