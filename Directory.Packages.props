<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Zentrale Paketversionen, gleiche Auswahl wie VibeVHS. Nicht verwenden: QuestPDF, MediatR, AutoMapper, FluentAssertions.
       Neue Pakete nur nach Rückfrage (ClosedXML freigegeben 11/2026; SAML und OIDC für die Anmeldung freigegeben 11/2026). -->
  <ItemGroup>
    <!-- Datenbank: PostgreSQL 17 (Npgsql) seit 11/2026; SQLite nur noch für die einmalige Übernahme alter Datenbanken (Aufruf mit sqlite-uebernehmen) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Radzen.Blazor" Version="13.1.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="4.7.3" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- Anmeldung: SAML 2.0 (Shibboleth, wie Podium) und OpenID Connect -->
    <PackageVersion Include="Sustainsys.Saml2.AspNetCore2" Version="2.11.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <!-- Betrieb: OpenTelemetry (Traces/Metriken per OTLP, Prometheus-Endpunkt), freigegeben 11/2026 -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.21.0-beta.1" />
    <!-- transitiv von PDFsharp: auf die sichere Version heben -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
