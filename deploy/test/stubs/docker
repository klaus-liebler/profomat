#!/usr/bin/env bash
# Nachbildung von docker für den Test: Der „Container“ <dienst>-db ist ein lokales PostgreSQL (Socket /var/run/postgresql, Rolle
# wie POSTGRES_USER mit Vertrauen über den Socket). Nur was das Kit für die Betriebsarten framework/self-contained braucht.
SIM="${SIM:-/tmp/sim}"; mkdir -p "$SIM/docker"
PGBIN="/usr/lib/postgresql/$(ls /etc/postgresql | sort -V | tail -1)/bin"   # Version des laufenden Clusters
export PATH="$PGBIN:$PATH" PGHOST=/var/run/postgresql
cmd="${1:-}"; shift || true
case "$cmd" in
    info) exit 0 ;;
    version) echo "27.0-sim" ;;
    compose) [[ "${1:-}" == version ]] && { echo "2.30-sim"; exit 0; }; exit 0 ;;
    ps)  for c in "$SIM"/docker/*.angelegt; do
             [[ -e "$c" ]] || continue
             n=$(basename "$c" .angelegt)
             if [[ " $* " == *" -a "* || -e "$SIM/docker/$n.laeuft" ]]; then echo "$n"; fi
         done ;;
    start) for n in "$@"; do [[ -e "$SIM/docker/$n.angelegt" ]] && touch "$SIM/docker/$n.laeuft"; done ;;
    stop)  for n in "$@"; do rm -f "$SIM/docker/$n.laeuft"; done; echo "$@" ;;
    inspect)
        n="${*: -1}"
        if [[ "$*" == *State.Running* ]]; then
            if [[ -e "$SIM/docker/$n.laeuft" && "$n" == *-db ]]; then echo true; else echo false; fi
        elif [[ "$*" == *Networks* ]]; then echo "${n%-db}-netz"
        elif [[ "$*" == *State.Status* ]]; then echo exited
        else [[ -e "$SIM/docker/$n.angelegt" ]] || exit 1; fi ;;
    network) exit 0 ;;
    run)
        name=""; benutzer=""; db=""
        while (( $# )); do
            case "$1" in
                --name) name="$2"; shift ;;
                -e) case "$2" in POSTGRES_USER=*) benutzer="${2#*=}" ;; POSTGRES_DB=*) db="${2#*=}" ;; esac; shift ;;
            esac
            shift
        done
        su postgres -c "$PGBIN/psql -q -c 'CREATE ROLE $benutzer SUPERUSER LOGIN'" >/dev/null 2>&1 || true
        su postgres -c "$PGBIN/createdb -O $benutzer $db" >/dev/null 2>&1 || true
        touch "$SIM/docker/$name.angelegt" "$SIM/docker/$name.laeuft"; echo "sim-$name" ;;
    exec)
        [[ "${1:-}" == "-i" ]] && shift
        n="$1"; shift
        [[ -e "$SIM/docker/$n.laeuft" ]] || { echo "Error: container $n is not running" >&2; exit 1; }
        exec "$@" ;;
    pull|build|images|rmi) exit 0 ;;
    *) echo "docker-Nachbildung: $cmd nicht unterstützt" >&2; exit 1 ;;
esac
