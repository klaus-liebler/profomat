# ProfOMat – Werte für das Deploy-Kit (eigene Datei je System; alles andere im Kit ist in allen vier Systemen gleich, siehe README.md).
# Wird von den Schritt-Skripten per „source“ und von deploy.ps1 gelesen. KEINE Geheimnisse – die stehen nur auf dem Server.

# ---- System ----
SYSTEM="ProfOMat"                     # Anzeigename in Meldungen
DIENST="profomat"                     # Dienstbenutzer, systemd-Unit, Verzeichnisse (/opt, /var/lib, /etc, /var/log, /var/backups), Container
APP="ProfOMat.Web"                    # Programmdatei im Paket (apphost bzw. <APP>.dll)
PROJEKT="src/ProfOMat.Web"            # für deploy.ps1: dotnet publish
LOESUNG="ProfOMat.slnx"               # für deploy.ps1: dotnet test vor dem Bauen

# ---- Server und Adresse ----
ZIEL="srvadmin@liebler.iui.hs-osnabrueck.de"           # SSH-Ziel für deploy.ps1 (überschreibbar mit -Ziel)
SSH_SCHLUESSEL="id_ed25519_liebler_iui_hs_osnabrueck"  # Datei in %USERPROFILE%\.ssh (optional)
HOST="liebler.iui.hs-osnabrueck.de"   # öffentlicher Hostname (TLS am Reverse Proxy)
PFAD="/profomat"                      # Pfad-Basis hinter dem Proxy
PORT="5082"                           # Kestrel bzw. Container nur auf 127.0.0.1 (belegt: VibeVHS 5080, FraktionPerfekt 5081, Podium 5090)
NGINX_SITE="/etc/nginx/sites-available/liebler.conf"   # Server-Block mit TLS, in den die Einbindung kommt (Grundgerüst)

# ---- Ausrollen ----
MODUS="framework"                     # framework = nur die App, ASP.NET-Core-Runtime 11 ist auf dem Server installiert
                                      # self-contained = App mit eigener Runtime · docker = App-Container (Runtime im Abbild)
WARTEZEIT="120"                       # Sekunden, bis eine nicht antwortende neue Version automatisch zurückgerollt wird
GESUND_PFAD="/gesund"                 # Lebenszeichen der Anwendung (unter PFAD)
# Zeilen im Startlog, bei denen sofort zurückgerollt wird (erweiterter regulärer Ausdruck, ohne Groß-/Kleinschreibung)
FEHLER_MUSTER="Unhandled exception|Application startup exception|Hosting failed to start|Failed to bind|address already in use|ConnectionStrings:ProfOMat|password authentication failed|\[[0-9:]+ FTL\]"
# Schalter, die auf einem öffentlichen Server verboten sind (Zeile in der Umgebungsdatei → Abbruch vor jeder Änderung)
VERBOTEN_MUSTER="^\s*(Anmeldung__TestanmeldungErlaubt|Demodaten__Anlegen)\s*=\s*[Tt]rue"
# Ordner in /var/lib/$DIENST, die mitgesichert werden (Schlüssel: Systemsiegel, Cookies, TOTP, SAML-Zertifikat, Feldverschlüsselung)
SICHERN_ORDNER="schluessel"

# ---- Datenbank (PostgreSQL 17 im eigenen Container $DIENST-db, Schritt postgresql.sh) ----
DB_PORT="5443"                        # nur auf 127.0.0.1 (SchulPerfekt 5440, VibeVHS 5441, FraktionPerfekt 5442)
DB_NAME="profomat"                    # Hauptdatenbank (weitere Datenbanken im Container werden automatisch mitgesichert)
VERBINDUNG="ProfOMat"                 # Name der Verbindung: ConnectionStrings__<VERBINDUNG>
SQLITE_ALT="profomat.db"              # alte SQLite-Datei in /var/lib/$DIENST (bis 11/2026) – einmalig übernehmen mit deploy.ps1 -SqliteUebernehmen
# Nach dem ersten Ausrollen: Gibt es noch kein Konto, erinnert das Kit an die Ersteinrichtung (SQL liefert die Anzahl der Konten)
ERSTEINRICHTUNG_SQL='SELECT count(*) FROM "Konten"'
