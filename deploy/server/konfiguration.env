# Feste Werte für das ProfOMat-Testsystem (wird von den Schritt-Skripten per „source“ gelesen; keine Geheimnisse!).
# Vor dem ersten Lauf prüfen bzw. anpassen (docs/deploy.md, Abschnitt „Vor dem ersten Lauf entscheiden“).
HOST="liebler.iui.hs-osnabrueck.de"   # derselbe Server und dasselbe Zertifikat wie VibeVHS, FraktionPerfekt und Podium
PFAD="/profomat"                      # Pfad-Basis hinter nginx
PORT="5082"                           # Kestrel nur auf 127.0.0.1 (belegt: VibeVHS 5080, FraktionPerfekt 5081, Podium 5090)
DIENST="profomat"                     # Dienstbenutzer, systemd-Unit, Verzeichnisse
NGINX_SITE="/etc/nginx/sites-available/liebler.conf"   # Server-Block aus dem VibeVHS-Kit (Schritt 03 dort)

# Ausrollen (schritte/ausrollen.sh; deploy.ps1 -Modus überschreibt MODUS)
MODUS="framework"                     # framework = nur die App, gemeinsame ASP.NET-Runtime auf dem Server
                                      # self-contained = App mit eigener Runtime · docker = Container (Runtime im Abbild)
APP="ProfOMat.Web"                    # Programmdatei im Paket
DB_DATEI="profomat.db"                # SQLite-Datei in /var/lib/$DIENST
WARTEZEIT="120"                       # Sekunden, bis eine nicht antwortende neue Version automatisch zurückgerollt wird
# Zeilen im Startlog, bei denen sofort zurückgerollt wird (erweiterter regulärer Ausdruck, ohne Groß-/Kleinschreibung)
FEHLER_MUSTER="Unhandled exception|Application startup exception|Hosting failed to start|Datenbankschema veraltet|Failed to bind|address already in use|SqliteException|\[[0-9:]+ FTL\]"
