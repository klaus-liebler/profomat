# ProfOMat (Testsystem) als systemd-Dienst – Vorlage, Schritt 01 füllt @…@ aus konfiguration.env
# und legt sie als /etc/systemd/system/@DIENST@.service ab.
# Self-contained Linux-Build in /opt/@DIENST@ (kein .NET auf dem Server nötig), Daten getrennt in /var/lib/@DIENST@.
# Geheimnisse und bewusste Schalter (Demodaten, Testanmeldung, Mail) stehen nur in /etc/@DIENST@/@DIENST@.env (root:@DIENST@, 0640).
[Unit]
Description=ProfOMat (Testsystem)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@DIENST@
Group=@DIENST@
WorkingDirectory=/opt/@DIENST@
ExecStart=/opt/@DIENST@/ProfOMat.Web
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

Environment=ASPNETCORE_ENVIRONMENT=Testsystem
# Nur lokal: nach außen spricht ausschließlich nginx (mit Zugangspasswort)
Environment=ASPNETCORE_URLS=http://127.0.0.1:@PORT@
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=PathBase=@PFAD@
Environment=ReverseProxy__Aktiv=true
Environment=ReverseProxy__Host=@HOST@
Environment=ProfOMat__OeffentlicheAdresse=https://@HOST@@PFAD@/
# Daten außerhalb des Programmordners: Ausrollen ersetzt nur /opt/@DIENST@, nie die Daten
Environment="ConnectionStrings__ProfOMat=Data Source=/var/lib/@DIENST@/profomat.db"
# Systemsiegel-Schlüssel und Cookie-Schlüssel (Data Protection) – gehören in die Sicherung, nie ins Repository
Environment=Speicher__Schluessel=/var/lib/@DIENST@/schluessel
Environment=Speicher__Logs=/var/log/@DIENST@
EnvironmentFile=-/etc/@DIENST@/@DIENST@.env

# Neue Dateien nur für den Dienst lesbar (Datenbank, Schlüssel)
UMask=0027

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/@DIENST@ /var/log/@DIENST@

[Install]
WantedBy=multi-user.target
