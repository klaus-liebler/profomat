# /etc/profomat/profomat.env – Geheimnisse und Schalter (root:profomat, 0640). NICHT ins Repository.
# Der Kit-Schritt einrichten.sh legt die Datei an, falls sie fehlt; postgresql.sh trägt die Datenbankverbindung ein
# (ConnectionStrings__ProfOMat=…). Nach Änderungen: sudo systemctl restart profomat (Docker: sudo bash <kit>/schritte/ausrollen.sh --neustart)
#
# Anmeldung (ASP.NET Core Identity): KEIN Passwort in dieser Datei. Das erste Konto (Systemverwaltung) legt man nach dem ersten
# Ausrollen auf der Anmeldeseite an (Ersteinrichtung, danach sofort zweiter Faktor per Authenticator-App); weitere Konten nur per
# Einladungslink (Verwaltung → Konten).
# Testanmeldung und Demodaten sind auf dem öffentlichen Server verboten – ausrollen.sh bricht sonst ab (VERBOTEN_MUSTER in konfiguration.env).

# Mail (ohne Host wird nur simuliert: Log „Mail simuliert“, nichts verlässt den Server)
#Mail__Host=
#Mail__Port=587
#Mail__StartTls=true
#Mail__Benutzer=
#Mail__Passwort=
#Mail__Absender=

# Fachliche Einstellungen (Standard: appsettings.json)
#ProfOMat__SekretariatEmail=

# Anmeldeverfahren (Kacheln auf /anmelden). Ohne Angabe: Passwort und Passkey, dazu Saml/Oidc, sobald unten konfiguriert.
#Anmeldung__Verfahren=Saml,Passwort,Passkey
#Anmeldung__MfaBeiSsoVerlangen=true
#Anmeldung__SperreNachFehlversuchen=5
#Anmeldung__SperreMinuten=15

# SAML (Shibboleth-IdP der Hochschule) – erst nach der Registrierung beim IdP einschalten. SP-Metadaten: https://<host>/profomat/Saml2
#Saml__IdpEntityId=https://shib-idp.hs-osnabrueck.de/idp/shibboleth
#Saml__Zugehoerigkeiten=employee@hs-osnabrueck.de,staff@hs-osnabrueck.de,faculty@hs-osnabrueck.de
#Saml__Kontakt=

# OIDC (z. B. Entra ID, Keycloak). Redirect-URI beim Anbieter: https://<host>/profomat/signin-oidc
#Oidc__Authority=
#Oidc__ClientId=
#Oidc__ClientSecret=
