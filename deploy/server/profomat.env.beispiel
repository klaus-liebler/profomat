# /etc/profomat/profomat.env – bewusste Schalter und Geheimnisse (root:profomat, 0640). NICHT ins Repository.
# Schritt 01 legt die Datei an, falls sie fehlt. Nach Änderungen: sudo systemctl restart profomat

# ---- Sicherheitsstand (bitte lesen: docs/deploy.md) ----
# Es gibt noch keine Hochschulanmeldung (SSO, Iteration 3). nginx verlangt davor für alles das Zugangspasswort.

# Testanmeldung: jedes Konto ohne Passwort wählbar. NUR, solange das Zugangspasswort davor steht und nur mit Demodaten.
#Anmeldung__TestanmeldungErlaubt=true

# Demodaten: erfundene Konten zur Testanmeldung, Katalog aus dem Mock-Hochschulsystem. Ohne Demodaten ist die Datenbank leer –
# dann das Startkonto der Systemverwaltung unten setzen (wird nur angelegt, solange es keine Demodaten gibt).
#Demodaten__Anlegen=true

# Startkonto der Systemverwaltung (Anmeldung mit Kennung und Passwort), nur ohne Demodaten
#Startkonto__Kennung=verwaltung
#Startkonto__Email=
#Startkonto__Passwort=

# Mail: ohne Host wird nur simuliert (Log „Mail simuliert“). Auf dem Testsystem leer lassen, solange Demodaten aktiv sind.
#Mail__Host=
#Mail__Port=587
#Mail__StartTls=true
#Mail__Benutzer=
#Mail__Passwort=
#Mail__Absender=

# Fachliche Einstellungen (Standard: appsettings.json)
#ProfOMat__SekretariatEmail=
