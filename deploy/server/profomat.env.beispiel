# /etc/profomat/profomat.env – Geheimnisse und Schalter (root:profomat, 0640). NICHT ins Repository.
# Schritt 01 legt die Datei an, falls sie fehlt. Nach Änderungen: sudo systemctl restart profomat
#
# Anmeldung wie Podium: KEIN Passwort in dieser Datei. Das erste Konto (Systemverwaltung) legt man nach dem ersten Ausrollen
# auf der Anmeldeseite an (Ersteinrichtung); weitere Konten nur per Einladungslink (Verwaltung → Konten).
# Testanmeldung und Demodaten sind auf dem öffentlichen Server verboten – ausrollen.sh bricht sonst ab.

# Mail (ohne Host wird nur simuliert: Log „Mail simuliert“, nichts verlässt den Server)
#Mail__Host=
#Mail__Port=587
#Mail__StartTls=true
#Mail__Benutzer=
#Mail__Passwort=
#Mail__Absender=

# Fachliche Einstellungen (Standard: appsettings.json)
#ProfOMat__SekretariatEmail=
